{
    "app-id": "dev.hanthor.PtyxisGhostty",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "ptyxis",
    "finish-args": [
        "--device=dri",
        "--filesystem=home",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "x-run-args": [
        "--standalone"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libportal",
            "config-opts": [
                "--buildtype=debugoptimized",
                "-Dbackend-gtk4=enabled",
                "-Dbackend-gtk3=disabled",
                "-Ddocs=false",
                "-Dtests=false"
            ],
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/flatpak/libportal/releases/download/0.9.0/libportal-0.9.0.tar.xz",
                    "sha256": "113910f06f39387328805397053d20c7acafb7388d8e6cd5e06e05efb9690735"
                }
            ]
        },
        {
            "name": "ghostty",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 libghostty.so /app/lib/libghostty.so",
                "install -Dm644 ghostty.h /app/include/ghostty.h",
                "mkdir -p /app/include/ghostty/vt",
                "install -Dm644 vt.h /app/include/ghostty/vt.h"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "ghostty-build/libghostty.so"
                },
                {
                    "type": "file",
                    "path": "ghostty-build/ghostty.h"
                },
                {
                    "type": "file",
                    "path": "ghostty-build/ghostty/vt.h"
                }
            ]
        },
        {
            "name": "ptyxis-ghostty",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Ddevelopment=true",
                "-Dlibc-compat=true",
                "-Dghostty_prefix=/app"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
