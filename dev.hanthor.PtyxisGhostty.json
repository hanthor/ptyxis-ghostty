{
    "app-id": "dev.hanthor.PtyxisGhostty",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "ptyxis",
    "finish-args": [
        "--allow=devel",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=host",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.Notifications"
    ],
    "x-run-args": [
        "--standalone"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libportal",
            "config-opts": [
                "--buildtype=debugoptimized",
                "-Dbackend-gtk4=enabled",
                "-Dbackend-gtk3=disabled",
                "-Ddocs=false",
                "-Dtests=false"
            ],
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/flatpak/libportal/releases/download/0.9.0/libportal-0.9.0.tar.xz",
                    "sha256": "113910f06f39387328805397053d20c7acafb7388d8e6cd5e06e05efb9690735"
                }
            ]
        },
        {
            "name": "ghostty",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 lib/libghostty-vt.so.0.1.0 /app/lib/libghostty-vt.so.0.1.0",
                "ln -sf libghostty-vt.so.0.1.0 /app/lib/libghostty-vt.so.0",
                "ln -sf libghostty-vt.so.0 /app/lib/libghostty-vt.so",
                "cp -r include/ghostty /app/include/ghostty",
                "install -Dm644 include/ghostty.h /app/include/ghostty.h"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "subprojects/ghostty/zig-out"
                }
            ]
        },
        {
            "name": "ptyxis-ghostty",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Ddevelopment=true",
                "-Dlibc-compat=true",
                "-Dghostty_prefix=/app",
                "-Dapp-id=dev.hanthor.PtyxisGhostty",
                "-Dgschema-id=dev.hanthor.PtyxisGhostty",
                "-Dgschema-path=/dev/hanthor/PtyxisGhostty/"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
